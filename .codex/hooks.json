{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$(git rev-parse --show-toplevel)\" && node scripts/history.mjs hook",
            "timeout": 20
          },
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/scripts/konsistent-hook.mjs\"",
            "timeout": 20
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$(git rev-parse --show-toplevel)\" && node scripts/history.mjs hook",
            "timeout": 20
          }
        ]
      }
    ]
  }
}
